{
  "rewrites": [
    {
      "source": "/download",
      "destination": "/api/download"
    },
    {
      "source": "/ClipStash.dmg",
      "destination": "/api/download"
    }
  ],
  "headers": [
    {
      "source": "/downloads/ClipStash.dmg",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"ClipStash.dmg\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
