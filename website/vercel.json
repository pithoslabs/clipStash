{
  "rewrites": [
    {
      "source": "/download",
      "destination": "/api/download"
    },
    {
      "source": "/download/",
      "destination": "/api/download"
    },
    {
      "source": "/ClipStash.zip",
      "destination": "/api/download"
    },
    {
      "source": "/ClipStash.dmg",
      "destination": "/api/download"
    },
    {
      "source": "/changelog",
      "destination": "/changelog.html"
    }
  ],
  "headers": [
    {
      "source": "/downloads/ClipStash-v2.1.0.zip",
      "headers": [
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"ClipStash-v2.1.0.zip\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
